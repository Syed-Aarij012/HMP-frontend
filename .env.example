# Copy to .env.local and adjust. Restart `npm run dev` after changing these.

# Laravel API (HMP-backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Live auction updates (Laravel Reverb). Must match HMP-backend/.env:
# REVERB_APP_KEY / REVERB_HOST / REVERB_PORT / REVERB_SCHEME.
# The app KEY is public (it ships to the browser); never put REVERB_APP_SECRET here.
# Without the key the auction pages still work, just without live updates.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8090
NEXT_PUBLIC_REVERB_SCHEME=http
